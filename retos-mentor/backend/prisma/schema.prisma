generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Career {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]
  subjects Subject[]
}

model Subject {
  id       Int     @id @default(autoincrement())
  careerId Int
  name     String
  career   Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  topics   Topic[]
}

model Topic {
  id        Int                    @id @default(autoincrement())
  subjectId Int
  name      String
  resources AcademicResource[]
  progress  StudentTopicProgress[]
  subject   Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model AcademicResource {
  id          Int      @id @default(autoincrement())
  topicId     Int
  title       String
  description String?
  url         String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, isActive])
}

model Student {
  id       Int                    @id @default(autoincrement())
  name     String
  careerId Int
  sessions MentorSession[]
  career   Career                 @relation(fields: [careerId], references: [id])
  progress StudentTopicProgress[]
}

model StudentTopicProgress {
  studentId Int
  topicId   Int
  level     ProgressLevel @default(NOT_EVALUATED)
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([studentId, topicId])
}

model MentorSession {
  id        Int             @id @default(autoincrement())
  studentId Int
  createdAt DateTime        @default(now())
  messages  MentorMessage[]
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model MentorMessage {
  id        Int           @id @default(autoincrement())
  sessionId Int
  role      String
  content   String
  createdAt DateTime      @default(now())
  session   MentorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum ProgressLevel {
  NOT_EVALUATED
  BEGINNER
  IN_PROGRESS
  COMPETENT
}
